# SerWish API - copy to .env for local development. Never commit .env.
# The server validates this file at boot (src/config/env.js) and refuses to start if it is wrong.

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Set to true only on a machine with a writable disk; hosted logs go to stdout.
LOG_TO_FILE=false
# Number of proxies in front of the app (Render/AWS ALB = 1).
TRUST_PROXY_HOPS=1

# --- Supabase (database only; auth is Firebase) ---------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role key: Settings > API. Server only. Never put it in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Firebase Admin (verifies sign-in tokens, sends push) -----------------------
# Recommended: paste the whole service-account JSON, or its base64, on one line:
#   base64 -w0 serwish-firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or point to the file (local development):
# GOOGLE_APPLICATION_CREDENTIALS=./serwish-firebase-adminsdk.json
# Or the three separate values (the key must keep its \n escapes):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- CORS ----------------------------------------------------------------------
# Browser origins only (admin dashboard). The mobile app sends no Origin and is always allowed.
ALLOWED_ORIGINS=http://localhost:5173

# --- Marketplace rules (owner decisions, 2026-10-01) -------------------------------
MATCH_RADIUS_KM=5
JOB_OFFER_SECONDS=45
MATCHING_TIMEOUT_SECONDS=300
PLATFORM_FEE_INR=0
CANCELLATION_FEE_INR=0
LOCATION_MIN_INTERVAL_MS=4000
# Dispatcher: tick interval, and how early a scheduled job is offered to partners.
DISPATCH_INTERVAL_MS=2000
DISPATCH_LEAD_MINUTES=60
ENABLE_DISPATCHER=true
MAX_ACTIVE_BOOKINGS=3
MAX_SCHEDULE_DAYS=14

# --- Feature switches ------------------------------------------------------------------
FEATURE_BOOKINGS=true
# Online payments (card, net banking via Razorpay) ship in Backend Phase 5.
FEATURE_PAYMENTS=false

# --- Partner verification (KYC) ------------------------------------------------------
# manual   : no automatic checks; the app hides DigiLocker; selfie and bank go to admin review (default)
# fake     : simulated DigiLocker / face / bank for development (blocked in production unless allowed below)
# cashfree : Cashfree Secure ID (DigiLocker, face liveness + match, bank account check)
KYC_PROVIDER=fake
KYC_ALLOW_FAKE_IN_PRODUCTION=false
# Random secret, 32+ characters, for duplicate-ID and bank-account hashes. Set once; never change.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_HASH_PEPPER=
# Public https origin of this API (DigiLocker sends partners back here).
PUBLIC_API_URL=http://localhost:5000
KYC_FACE_MATCH_THRESHOLD=0.75
KYC_NAME_MATCH_MIN=70
# Category slugs whose partners must upload a skill certificate, comma-separated.
KYC_CERT_REQUIRED_CATEGORIES=
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2024-12-01
